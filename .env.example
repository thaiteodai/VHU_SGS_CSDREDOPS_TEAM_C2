# Copy to .env and edit. Never commit the real .env.

# --- Required in production -------------------------------------------------
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
POSTGRES_PASSWORD=change-me
COOKIE_SECURE=false

# --- Public URLs -------------------------------------------------------------
# Where the browser reaches the app.
CLIENT_ORIGIN=http://localhost:8080
APP_URL=http://localhost:8080

# --- TideCloak ---------------------------------------------------------------
TIDECLOAK_ADMIN=admin
TIDECLOAK_ADMIN_PASSWORD=change-me
# Inside Docker Compose the server talks to TideCloak over the internal network.
# For local development without Docker, point these at localhost:8081.
TIDECLOAK_ISSUER=http://tidecloak:8080/realms/panicplan
TIDECLOAK_AUTHORIZATION_ENDPOINT=http://tidecloak:8080/realms/panicplan/protocol/openid-connect/auth
TIDECLOAK_TOKEN_ENDPOINT=http://tidecloak:8080/realms/panicplan/protocol/openid-connect/token
TIDECLOAK_USERINFO_ENDPOINT=http://tidecloak:8080/realms/panicplan/protocol/openid-connect/userinfo
TIDECLOAK_JWKS_URI=http://tidecloak:8080/realms/panicplan/protocol/openid-connect/certs
TIDECLOAK_CLIENT_ID=panicplan-web
TIDECLOAK_CLIENT_SECRET=
TIDECLOAK_REDIRECT_URI=http://localhost:8080/auth/callback
TIDECLOAK_AUDIENCE=panicplan-web

# --- Email (optional; without it links print to the server log) --------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Panic Plan <no-reply@panicplan.local>

# --- Monitoring (optional) ---------------------------------------------------
SENTRY_DSN=

# --- Meme service (optional) -------------------------------------------------
MEME_API_URL=https://api.memegen.link
MEME_ENABLED=true
