DATABASE_URL="postgresql://panicplan:panicplan@localhost:5432/panicplan?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
REFRESH_TTL_REMEMBER_SECONDS=2592000
COOKIE_NAME=pp_session
COOKIE_SECURE=false
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"

SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Panic Plan <no-reply@panicplan.local>"

SENTRY_DSN=""

TIDECLOAK_ISSUER="http://localhost:8080/realms/panicplan"
TIDECLOAK_AUTHORIZATION_ENDPOINT="http://localhost:8080/realms/panicplan/protocol/openid-connect/auth"
TIDECLOAK_TOKEN_ENDPOINT="http://localhost:8080/realms/panicplan/protocol/openid-connect/token"
TIDECLOAK_USERINFO_ENDPOINT="http://localhost:8080/realms/panicplan/protocol/openid-connect/userinfo"
TIDECLOAK_JWKS_URI="http://localhost:8080/realms/panicplan/protocol/openid-connect/certs"
TIDECLOAK_CLIENT_ID="panicplan-web"
TIDECLOAK_CLIENT_SECRET="change-me-tidecloak-secret"
TIDECLOAK_REDIRECT_URI="http://localhost:5173/auth/callback"
TIDECLOAK_AUDIENCE="panicplan-web"

MEME_API_URL="https://api.memegen.link"
MEME_CACHE_TTL_MS=21600000
MEME_ENABLED=true
BACKUP_DIR="./backups"
